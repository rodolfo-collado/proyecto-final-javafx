<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.practice.aulaequilibrio.controller.SubjectController"
      spacing="10" minWidth="280" styleClass="panel">
    <Label text="Asignaturas" styleClass="card-title"/>
    <FlowPane hgap="7" vgap="6">
        <Button text="Nueva asignatura" onAction="#create" styleClass="primary"/>
        <Button fx:id="editButton" text="Editar" onAction="#edit"/>
        <Button fx:id="deleteButton" text="Eliminar asignatura" onAction="#delete" styleClass="danger"/>
        <Button text="Actualizar" onAction="#refresh"/>
    </FlowPane>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label text="No hay asignaturas registradas."/></placeholder>
        <columns>
            <TableColumn fx:id="codigoColumn" text="Código" prefWidth="100"/>
            <TableColumn fx:id="nombreColumn" text="Nombre" prefWidth="180"/>
            <TableColumn fx:id="sesionesColumn" text="Sesiones" prefWidth="85"/>
        </columns>
    </TableView>
</VBox>
