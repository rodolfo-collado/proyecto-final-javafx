<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.practice.aulaequilibrio.controller.CatalogController"
      spacing="12" styleClass="module-page">
    <Label text="Docentes y disponibilidad" styleClass="page-title"/>
    <SplitPane fx:id="catalogs" dividerPositions="0.64" VBox.vgrow="ALWAYS" styleClass="module-split">
        <VBox spacing="10" minWidth="290" styleClass="panel">
            <Label text="Docentes" styleClass="card-title"/>
            <FlowPane hgap="7" vgap="6">
                <Button text="Nuevo docente" onAction="#newTeacher" styleClass="primary"/>
                <Button fx:id="editTeacherButton" text="Editar" onAction="#editTeacher"/>
                <Button fx:id="deleteTeacherButton" text="Eliminar docente" onAction="#deleteTeacher" styleClass="danger"/>
                <Button text="Actualizar" onAction="#reload"/>
            </FlowPane>
            <HBox spacing="7" alignment="CENTER_LEFT">
                <TextField fx:id="teacherSearch" promptText="Buscar por nombre o correo"
                           accessibleText="Buscar docentes" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="emailFilter" accessibleText="Filtrar docentes por correo" prefWidth="120"/>
            </HBox>
            <TableView fx:id="teachers" VBox.vgrow="ALWAYS">
                <placeholder><Label fx:id="emptyTeachers" text="No hay docentes registrados."/></placeholder>
                <columns>
                    <TableColumn fx:id="teacherName" text="Nombre" prefWidth="230"/>
                    <TableColumn fx:id="teacherEmail" text="Correo" prefWidth="270"/>
                </columns>
            </TableView>
        </VBox>
        <VBox fx:id="availabilityPanel" spacing="10" minWidth="260" styleClass="panel">
            <VBox spacing="3">
                <Label text="Disponibilidad" styleClass="card-title"/>
                <Label fx:id="availabilityTitle" text="Selecciona un docente" wrapText="true" styleClass="muted"/>
            </VBox>
            <HBox spacing="7" alignment="CENTER_LEFT">
                <ComboBox fx:id="dayFilter" accessibleText="Filtrar disponibilidad por día" prefWidth="145"/>
                <TextField fx:id="blockFilter" promptText="N.º de bloque" accessibleText="Filtrar por número de bloque"
                           prefColumnCount="7" HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="blocks" VBox.vgrow="ALWAYS" minHeight="120">
                <placeholder>
                    <Label fx:id="emptyBlocks" text="Selecciona un docente para ver sus bloques." wrapText="true"/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="blockDay" text="Día" prefWidth="150"/>
                    <TableColumn fx:id="blockValue" text="Bloque" prefWidth="90"/>
                </columns>
            </TableView>
            <Label fx:id="blockEditorTitle" text="Nuevo bloque" styleClass="card-title"/>
            <ComboBox fx:id="day" promptText="Día de la semana" maxWidth="Infinity"/>
            <TextField fx:id="blockNumber" promptText="Número de bloque"/>
            <FlowPane hgap="7" vgap="6">
                <Button text="Nuevo bloque" onAction="#newBlock"/>
                <Button text="Guardar bloque" onAction="#saveBlock" styleClass="primary"/>
                <Button fx:id="deleteBlockButton" text="Eliminar bloque" onAction="#deleteBlock" styleClass="danger"/>
            </FlowPane>
        </VBox>
    </SplitPane>
    <Label fx:id="status" text="Cargando docentes…" wrapText="true" styleClass="muted"/>
</VBox>
