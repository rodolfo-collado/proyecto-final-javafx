<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.practice.aulaequilibrio.controller.GroupeController"
      spacing="10" minWidth="280" styleClass="panel">
    <Label text="Grupos" styleClass="card-title"/>
    <FlowPane hgap="7" vgap="6">
        <Button text="Nuevo grupo" onAction="#create" styleClass="primary"/>
        <Button fx:id="editButton" text="Editar" onAction="#edit"/>
        <Button fx:id="deleteButton" text="Eliminar grupo" onAction="#delete" styleClass="danger"/>
        <Button text="Actualizar" onAction="#refresh"/>
    </FlowPane>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label text="No hay grupos registrados."/></placeholder>
        <columns>
            <TableColumn fx:id="nombreColumn" text="Nombre" prefWidth="180"/>
            <TableColumn fx:id="cantidadColumn" text="Estudiantes" prefWidth="115"/>
        </columns>
    </TableView>
</VBox>
