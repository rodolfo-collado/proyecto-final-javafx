<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>

<TabPane xmlns:fx="http://javafx.com/fxml"
         fx:controller="com.practice.aulaequilibrio.controller.HomeController"
         tabClosingPolicy="UNAVAILABLE">
    <Tab text="Inicio">
        <VBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <Label fx:id="welcomeMessage"/>
            <Button text="Bienvenido" onAction="#showWelcomeMessage"/>
            <Button text="Horarios" onAction="#openSchedules"/>
        </VBox>
    </Tab>
    <Tab text="Grupos">
        <fx:include source="groupe-view.fxml"/>
    </Tab>
    <Tab text="Asignaturas">
        <fx:include source="subject-view.fxml"/>
    </Tab>
</TabPane>
